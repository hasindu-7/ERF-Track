Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^app-private(?:/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
<FilesMatch "^(\.env.*|config\.local\.php|setup-key\.php)$">
    Require all denied
</FilesMatch>
